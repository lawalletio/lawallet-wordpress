#. Plugin URI of the plugin
#: lawallet-lightning-address.php
msgid "https://wordpress.lawallet.io"
msgstr "https://wordpress.lawallet.io"

#. Description of the plugin
#: lawallet-lightning-address.php
msgid ""
"Connect payments with most popular Lightning wallets without registration or "
"credentials."
msgstr ""
"Conecta los pagos con las billeteras Lightning más populares sin registro ni "
"credenciales."

#. Author of the plugin
#: lawallet-lightning-address.php
msgid "LaWallet"
msgstr "LaWallet"

#. Author URI of the plugin
